<Application x:Class="AmqTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:AmqTool"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--Image resources-->
        <BitmapImage x:Key="CheckIcon" UriSource="pack://application:,,,/Assets/Icons/checkmark.png"/>

        <!--Color resources-->
        <!--Color resources-->
        <Color x:Key="PrimaryTextColor">#000</Color>
        <Color x:Key="PrimaryTextShadow">#ccc</Color>
        <SolidColorBrush x:Key="PrimaryText" Color="#000"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#3f3f46"/>
        <SolidColorBrush x:Key="TerciaryText" Color="#999"/>
        <SolidColorBrush x:Key="HomeTitle" Color="#fff"/>
        <SolidColorBrush x:Key="UrlColor" Color="#009bee"/>

        <SolidColorBrush x:Key="StatusBarBg" Color="AliceBlue"/>
        <SolidColorBrush x:Key="TopNavBar" Color="#f0f0f0"/>
        <SolidColorBrush x:Key="BackgroundPrimary" Color="#fff"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1e1e1e"/>
        <SolidColorBrush x:Key="BackgroundDarkSecondary" Color="#FF323232"/>

        <SolidColorBrush x:Key="BtnPrimary" Color="#eee"/>

        <!--TODO-->
        <SolidColorBrush x:Key="BtnPrimary_Hover" Color="#ddd"/>
        <SolidColorBrush x:Key="BtnPrimary_Border" Color="#bbb"/>

        <SolidColorBrush x:Key="BtnSecondary" Color="#ddd"/>
        <SolidColorBrush x:Key="BtnTerciary" Color="#fae9c3"/>


        <DropShadowEffect x:Key="DropShadowPrimary" 
                          ShadowDepth="2"
                          BlurRadius="5"
                          Color="{DynamicResource PrimaryTextColor}">
        </DropShadowEffect>

        <DropShadowEffect x:Key="DropShadowSecondary" 
                          ShadowDepth="1"
                          BlurRadius="1"
                          Color="{DynamicResource PrimaryTextShadow}">
        </DropShadowEffect>


        <!--Style resources-->
        <!--Gobal-->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BtnPrimary}"/>
        </Style>

        <Style TargetType="ToolTip">
            <Style.Resources>
                <Style TargetType="ContentPresenter">
                    <Style.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </Style.Resources>
                </Style>
            </Style.Resources>
            <Setter Property="MaxWidth" Value="350"/>
        </Style>

        <!--Other-->
        <!--Homepage title-->
        <Style x:Key="HomePageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36px"></Setter>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource HomeTitle}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 20 0 0"/>
            <Setter Property="Effect" Value="{DynamicResource DropShadowPrimary}"/>
        </Style>

        <!--Keybinds-->
        <Style x:Key="KeybindsSettingsMainTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28px"></Setter>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 20 0 0"/>
            <Setter Property="Effect" Value="{DynamicResource DropShadowSecondary}"/>
        </Style>

        <Style x:Key="KeybindsSettingsSubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16px"></Setter>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 20 0 10"/>
        </Style>

        <Style x:Key="Seperator_KBS" TargetType="Rectangle">
            <Setter Property="Height" Value="2"></Setter>
            <Setter Property="Opacity" Value="0.5"></Setter>
            <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
            <Setter Property="Fill" Value="{DynamicResource SecondaryText}"></Setter>
            <Setter Property="Stroke" Value="{DynamicResource SecondaryText}"></Setter>
        </Style>

        <Style x:Key="Seperator_KBS_ADV" TargetType="Rectangle">
            <Setter Property="Height" Value="2"></Setter>
            <Setter Property="Opacity" Value="0.5"></Setter>
            <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
            <Setter Property="Fill" Value="{DynamicResource SecondaryText}"></Setter>
            <Setter Property="Stroke" Value="{DynamicResource SecondaryText}"></Setter>
            <Setter Property="Margin" Value="0 10 0 0"/>
        </Style>

        <Style x:Key="HoverHand" TargetType="Image">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--Spaghetti code sucks-->
        <!--Yes I know how to make this compact and short, but I forgot about user controls when wrote this, nyeh-->
        <!--Maybe one day in the future-->
        <sys:Double x:Key="WidthHeight">22</sys:Double>

        <Style x:Key="JobsBTN_Edit" TargetType="Button">
            <Setter Property="Height" Value="{StaticResource WidthHeight}"></Setter>
            <Setter Property="Width" Value="{StaticResource WidthHeight}"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="2">
                            <Image Margin="0" Source="pack://application:,,,/Assets/Icons/pencil.png"/>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="#FF5FADFB"/>
                                    <Style.Triggers>
                                        <Trigger Property="Border.IsMouseOver" Value="True">
                                            <Setter Property="Border.Background" Value="#47a2fc"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

