<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:forms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
    xmlns:local="clr-namespace:Mpv.Net.Wpf">

    <Style x:Key="PlayerTimers" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20px"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--Slider style start-->
    <sys:Double x:Key="MyTrackHeight">26</sys:Double>
    <!--Right from thumb-->
    <Style x:Key="RSliderRepeatButton" TargetType="RepeatButton">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border BorderThickness="2" BorderBrush="#DDD" Background="#DDD" Height="{StaticResource MyTrackHeight}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--Left from thumb-->
    <Style x:Key="RSliderRepeatButton1" TargetType="RepeatButton">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border SnapsToDevicePixels="True" Background="#3EB0F5" BorderThickness="1" BorderBrush="#3EB0F5" Height="{StaticResource MyTrackHeight}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--Thumb-->
    <Style x:Key="RSliderThumb" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Rectangle Height="{StaticResource MyTrackHeight}" Width="2" Fill="#FFF"></Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="RSlider" TargetType="Slider">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Track Grid.Row="1" x:Name="PART_Track" >
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource RSliderRepeatButton1}"  Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource RSliderThumb}"  />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource RSliderRepeatButton}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style x:Key="SliderStyle" TargetType="Slider">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="Margin" Value="5"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Template" Value="{StaticResource RSlider}" />
    </Style>
    <!--Slider style end-->

    <Style TargetType="{x:Type local:MpvPlayer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MpvPlayer}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource SliderStyle}"
                                x:Name="PART_Seek"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                IsMoveToPointEnabled="True"
                                />
                            <!--ToolTip="{Binding ElementName=PART_Seek, Path=Value, Converter={local:DoubleToTimeConverter}}"-->
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="PART_PlayPause"
                                    ToolTip="Play/Pause"
                                    Margin="1">
                                    <Viewbox
                                        Width="32"
                                        Height="32">
                                        <Canvas
                                            Width="24"
                                            Height="24">
                                            <Path
                                                Data="M3,5V19L11,12M13,19H16V5H13M18,5V19H21V5"
                                                Fill="{TemplateBinding Foreground}" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button
                                    x:Name="PART_Stop"
                                    ToolTip="Stop"
                                    Margin="1">
                                    <Viewbox
                                        Width="32"
                                        Height="32">
                                        <Canvas
                                            Width="24"
                                            Height="24">
                                            <Path
                                                Data="M18,18H6V6H18V18Z"
                                                Fill="{TemplateBinding Foreground}" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button
                                    x:Name="PART_CopyCurTimestampToClipb"
                                    ToolTip="Copy current timestamp to clipboard"
                                    Margin="1">
                                    <Viewbox
                                        Width="32"
                                        Height="32">
                                        <Canvas
                                            Width="24"
                                            Height="24">
                                            <Path
                                                Data="M4 2V8H2V2H4M2 22V16H4V22H2M5 12C5 13.11 4.11 14 3 14C1.9 14 1 13.11 1 12C1 10.9 1.9 10 3 10C4.11 10 5 10.9 5 12M16 4C20.42 4 24 7.58 24 12C24 16.42 20.42 20 16 20C12.4 20 9.36 17.62 8.35 14.35L6 12L8.35 9.65C9.36 6.38 12.4 4 16 4M16 6C12.69 6 10 8.69 10 12C10 15.31 12.69 18 16 18C19.31 18 22 15.31 22 12C22 8.69 19.31 6 16 6M15 13V8H16.5V12.2L19.5 14L18.68 15.26L15 13Z"
                                                Fill="{TemplateBinding Foreground}"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Button
                                        x:Name="PART_JumpMarkerStart"
                                        ToolTip="Mark this timestamp as start"
                                        Grid.Row="0"
                                        Margin="1">
                                        <Viewbox
                                            Width="20"
                                            Height="20">
                                            <Canvas
                                                Width="24"
                                                Height="24">
                                                <Path  Data="M9 11.5C7.62 11.5 6.5 10.38 6.5 9S7.62 6.5 9 6.5 11.5 7.62 11.5 9 10.38 11.5 9 11.5M9 2C5.13 2 2 5.13 2 9C2 14.25 9 22 9 22S16 14.25 16 9C16 5.13 12.87 2 9 2M18 17L23 12L18 7V17Z"
                                                    Fill="{TemplateBinding Foreground}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <Button
                                        x:Name="PART_JumpMarkerEnd"
                                        ToolTip="Mark this timestamp as end"
                                        Grid.Row="1"
                                        Margin="1">
                                        <Viewbox
                                            Width="20"
                                            Height="20">
                                            <Canvas
                                                Width="24"
                                                Height="24">
                                                <Path  Data="M15 11.5C13.62 11.5 12.5 10.38 12.5 9S13.62 6.5 15 6.5 17.5 7.62 17.5 9 16.38 11.5 15 11.5M8 9C8 14.25 15 22 15 22S22 14.25 22 9C22 5.13 18.87 2 15 2S8 5.13 8 9M6 7L1 12L6 17V7Z"
                                                    Fill="{TemplateBinding Foreground}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Button
                                        x:Name="PART_JumpStart"
                                        ToolTip="Jump to start of set timestamp"
                                        Grid.Row="0"
                                        Margin="1">
                                        <Viewbox
                                            Width="20"
                                            Height="20">
                                            <Canvas
                                                Width="24"
                                                Height="24">
                                                <Path  Data="M4,2H2V22H4V13H18.17L12.67,18.5L14.08,19.92L22,12L14.08,4.08L12.67,5.5L18.17,11H4V2Z"
                                                    Fill="{TemplateBinding Foreground}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <ToggleButton
                                        x:Name="PART_JumpEnd"
                                        ToolTip="Jump to end of set timestamp (Toggling ON = will jump to end and not allow to go further) (Toggling OFF = it will now allow to go further again but won't jump)"
                                        Grid.Row="1"
                                        Margin="1">
                                        <Viewbox
                                            Width="20"
                                            Height="20">
                                            <Canvas
                                                Width="24"
                                                Height="24">
                                                <Path  Data="M20,22H22V2H20V11H5.83L11.33,5.5L9.92,4.08L2,12L9.92,19.92L11.33,18.5L5.83,13H20V22Z"
                                                    Fill="{TemplateBinding Foreground}" />
                                            </Canvas>
                                        </Viewbox>
                                    </ToggleButton>
                                </Grid>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Button
                                        x:Name="PART_Audio"
                                        ToolTip="Ffmeg will take the audio that's currently selected in the player."
                                        Grid.Row="0"
                                        Margin="1">
                                        <Viewbox
                                            Width="20"
                                            Height="20">
                                            <Canvas
                                                Width="24"
                                                Height="24">
                                                <Path  Data="M12,12A3,3 0 0,0 9,15A3,3 0 0,0 12,18A3,3 0 0,0 15,15A3,3 0 0,0 12,12M12,20A5,5 0 0,1 7,15A5,5 0 0,1 12,10A5,5 0 0,1 17,15A5,5 0 0,1 12,20M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8C10.89,8 10,7.1 10,6C10,4.89 10.89,4 12,4M17,2H7C5.89,2 5,2.89 5,4V20A2,2 0 0,0 7,22H17A2,2 0 0,0 19,20V4C19,2.89 18.1,2 17,2Z"
                                                    Fill="{TemplateBinding Foreground}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <Button
                                        x:Name="PART_Subtitle"
                                        ToolTip="Change subtitles"
                                        Grid.Row="1"
                                        Margin="1">
                                        <Viewbox
                                            Width="20"
                                            Height="20">
                                            <Canvas
                                                Width="24"
                                                Height="24">
                                                <Path  Data="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M8,14H6V12H8V14M8,11H6V9H8V11M8,8H6V6H8V8M15,14H10V12H15V14M18,11H10V9H18V11M18,8H10V6H18V8Z"
                                                    Fill="{TemplateBinding Foreground}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource PlayerTimers}" Width="115px" x:Name="PART_cur" Margin="10 3 0 0" Text="00:00:00.000"/>
                                <TextBlock Style="{StaticResource PlayerTimers}" Margin="2 3 4 0" Text="/"/>
                                <TextBlock Style="{StaticResource PlayerTimers}" Width="115px" x:Name="PART_max" Margin="0 3 0 0" Text="00:00:00.000"/>
                            </StackPanel>
                            <Slider
                                x:Name="PART_Volume"
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="200"
                                Margin="5,0"
                                VerticalAlignment="Center"
                                IsMoveToPointEnabled="True"
                                IsSnapToTickEnabled="True"
                                Maximum="100"
                                Minimum="0"
                                TickFrequency="1"
                                ToolTip="{Binding ElementName=PART_Volume, Path=Value}"
                                Value="100" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:MpvDisplay}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MpvDisplay}">
                    <WindowsFormsHost x:Name="PART_Host">
                        <forms:Panel />
                    </WindowsFormsHost>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
