<Window x:Class="AmqTool.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AmqTool"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="About page" Height="320" Width="300">
    <Grid Background="#1e1e1e">
        <StackPanel>
            <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Text="AmqTool" Style="{StaticResource AboutMain}"/>
            <TextBlock HorizontalAlignment="Center" Text="Author: Kiki#0002" Style="{StaticResource AboutSub}"/>
            <TextBlock MouseDown="TextBlock_MouseDown" HorizontalAlignment="Center" Text="Source code"  Style="{StaticResource AboutSub_url}"/>
            <Separator Margin="0 20 0 0"/>
            <TextBlock HorizontalAlignment="Center" TextAlignment="Justify" Text="This program is an interactive tool for anything related to AMQ video rendering, making clips, easing the batch render job creading process, analyzing media and more. If anyone finds any problems or improvements dm me on discord." Style="{StaticResource AboutDescription}"/>
        </StackPanel>
    </Grid>
</Window>
