<Window x:Class="AmqTool.ConfigSetup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AmqTool"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        Title="ConfigSetup" Height="570" Width="500">
    <Grid Background="#1e1e1e">
        <Grid.RowDefinitions>
            <RowDefinition Height="401*"/>
            <RowDefinition Height="70*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.RowSpan="2">
            <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Text="Config setup" Style="{StaticResource AboutMain}"/>
            <Separator DockPanel.Dock="Top" Margin="0 20 0 0"/>
            <StackPanel DockPanel.Dock="Top" x:Name="TBXSP">
                <!--The bindings-->
                <!--Folder-->
                <StackPanel Margin="20 20 0 0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBox Name="FromVegasPath_0" LostFocus="Tbx_LostFocus" GotFocus="Tbx_GotFocus" TextChanged="Tbx_TextChanged" Style="{StaticResource Tbx_Edi4}" Text="{Binding FromVegasPath, Mode=TwoWay}" ToolTip="{Binding FromVegasPath}"/>
                    <Button Name="FromVegasPath_1" Click="Button_Click" Style="{StaticResource JobsBTN_OpenFolder}" Margin="5 0 0 0" />
                    <Button Name="FromVegasPath_2" Click="Button_Click" Style="{StaticResource JobsBTN_QuestionMark}" Margin="5 0 0 0" />
                    <Button Name="FromVegasPath_3" Click="Button_Click" Style="{StaticResource JobsBTN_ClearProcessVideoPath}" Margin="5 0 0 0" />
                    <TextBlock Name="FromVegasPath_4" Text="missing" Style="{StaticResource ConfigSetupWindow_WarnTXT}"/>
                </StackPanel>
                <!--Folder-->
                <StackPanel Margin="20 20 0 0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBox Name="IntoVegasMp4Path_0" LostFocus="Tbx_LostFocus" GotFocus="Tbx_GotFocus" TextChanged="Tbx_TextChanged" Style="{StaticResource Tbx_Edi4}" Text="{Binding IntoVegasMp4Path, Mode=TwoWay}" ToolTip="{Binding IntoVegasMp4Path}"/>
                    <Button Name="IntoVegasMp4Path_1" Click="Button_Click" Style="{StaticResource JobsBTN_OpenFolder}" Margin="5 0 0 0" />
                    <Button Name="IntoVegasMp4Path_2" Click="Button_Click" Style="{StaticResource JobsBTN_QuestionMark}" Margin="5 0 0 0" />
                    <Button Name="IntoVegasMp4Path_3" Click="Button_Click" Style="{StaticResource JobsBTN_ClearProcessVideoPath}" Margin="5 0 0 0" />
                    <TextBlock Name="IntoVegasMp4Path_4" Text="missing" Style="{StaticResource ConfigSetupWindow_WarnTXT}"/>
                </StackPanel>
                <!--Folder-->
                <StackPanel Margin="20 20 0 0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBox Name="DefaultOutPath_0" LostFocus="Tbx_LostFocus" GotFocus="Tbx_GotFocus" TextChanged="Tbx_TextChanged" Style="{StaticResource Tbx_Edi4}" Text="{Binding DefaultOutPath, Mode=TwoWay}" ToolTip="{Binding DefaultOutPath}"/>
                    <Button Name="DefaultOutPath_1" Click="Button_Click" Style="{StaticResource JobsBTN_OpenFolder}" Margin="5 0 0 0" />
                    <Button Name="DefaultOutPath_2" Click="Button_Click" Style="{StaticResource JobsBTN_QuestionMark}" Margin="5 0 0 0" />
                    <Button Name="DefaultOutPath_3" Click="Button_Click" Style="{StaticResource JobsBTN_ClearProcessVideoPath}" Margin="5 0 0 0" />
                    <TextBlock Name="DefaultOutPath_4" Text="missing" Style="{StaticResource ConfigSetupWindow_WarnTXT}"/>
                </StackPanel>
                <!--Folder-->
                <StackPanel Margin="20 20 0 0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBox Background="#FF252525" Foreground="#FFF96F46" Name="TmpPath_0" LostFocus="Tbx_LostFocus" GotFocus="Tbx_GotFocus" TextChanged="Tbx_TextChanged" Style="{StaticResource Tbx_Edi4}" Text="{Binding TmpPath, Mode=TwoWay}" ToolTip="{Binding TmpPath}"/>
                    <Button Name="TmpPath_1" Click="Button_Click" Style="{StaticResource JobsBTN_OpenFolder}" Margin="5 0 0 0" />
                    <Button Name="TmpPath_2" Click="Button_Click" Style="{StaticResource JobsBTN_QuestionMark}" Margin="5 0 0 0" />
                    <Button Name="TmpPath_3" Click="Button_Click" Style="{StaticResource JobsBTN_ClearProcessVideoPath}" Margin="5 0 0 0" />
                    <TextBlock Name="TmpPath_4" Text="missing" Style="{StaticResource ConfigSetupWindow_WarnTXT}"/>
                </StackPanel>
                
                <!--Folder-->
                <StackPanel Margin="20 20 0 0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBox Name="BgsPath_0" LostFocus="Tbx_LostFocus" GotFocus="Tbx_GotFocus" TextChanged="Tbx_TextChanged" Style="{StaticResource Tbx_Edi4}" Text="{Binding BgsPath, Mode=TwoWay}" ToolTip="{Binding BgsPath}"/>
                    <Button Name="BgsPath_1" Click="Button_Click" Style="{StaticResource JobsBTN_OpenFolder}" Margin="5 0 0 0" />
                    <Button Name="BgsPath_2" Click="Button_Click" Style="{StaticResource JobsBTN_QuestionMark}" Margin="5 0 0 0" />
                    <Button Name="BgsPath_3" Click="Button_Click" Style="{StaticResource JobsBTN_ClearProcessVideoPath}" Margin="5 0 0 0" />
                    <TextBlock Name="BgsPath_4" Text="missing" Style="{StaticResource ConfigSetupWindow_WarnTXT}"/>
                </StackPanel>

                <!--Folder-->
                <StackPanel Margin="20 20 0 0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBox Name="VolumeCheckerPath_0" LostFocus="Tbx_LostFocus" GotFocus="Tbx_GotFocus" TextChanged="Tbx_TextChanged" Style="{StaticResource Tbx_Edi4}" Text="{Binding VolumeCheckerPath, Mode=TwoWay}" ToolTip="{Binding VolumeCheckerPath}"/>
                    <Button Name="VolumeCheckerPath_1" Click="Button_Click" Style="{StaticResource JobsBTN_OpenFolder}" Margin="5 0 0 0" />
                    <Button Name="VolumeCheckerPath_2" Click="Button_Click" Style="{StaticResource JobsBTN_QuestionMark}" Margin="5 0 0 0" />
                    <Button Name="VolumeCheckerPath_3" Click="Button_Click" Style="{StaticResource JobsBTN_ClearProcessVideoPath}" Margin="5 0 0 0" />
                    <TextBlock Name="VolumeCheckerPath_4" Text="missing" Style="{StaticResource ConfigSetupWindow_WarnTXT}"/>
                </StackPanel>

                <!--Regular-->
                <StackPanel Margin="20 20 0 0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <PasswordBox Name="CatboxHash_0" PasswordChanged="CatboxHash_0_PasswordChanged" Style="{StaticResource Tbx_Edi4_}" Password="catbox hash" ToolTip="Catbox hash"/>
                    <Button Name="CatboxHash_2" Click="Button_Click" Style="{StaticResource JobsBTN_QuestionMark}" Margin="5 0 0 0" />
                    <Button Name="CatboxHash_3" Click="Button_Click" Style="{StaticResource JobsBTN_ClearProcessVideoPath}" Margin="5 0 0 0" />
                    <TextBlock Name="CatboxHash_4" Text="missing" Style="{StaticResource ConfigSetupWindow_WarnTXT}"/>
                </StackPanel>

                <!--Folder-->
                <StackPanel Margin="20 20 0 0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBox Name="FfmpegPath_0" LostFocus="Tbx_LostFocus" GotFocus="Tbx_GotFocus" TextChanged="Tbx_TextChanged" Style="{StaticResource Tbx_Edi4}" Text="{Binding FfmpegPath, Mode=TwoWay}" ToolTip="{Binding FfmpegPath}"/>
                    <Button Name="FfmpegPath_1" Click="Button_Click" Style="{StaticResource JobsBTN_OpenFolder}" Margin="5 0 0 0" />
                    <Button Name="FfmpegPath_2" Click="Button_Click" Style="{StaticResource JobsBTN_QuestionMark}" Margin="5 0 0 0" />
                    <Button Name="FfmpegPath_3" Click="Button_Click" Style="{StaticResource JobsBTN_ClearProcessVideoPath}" Margin="5 0 0 0" />
                    <TextBlock Name="FfmpegPath_4" Text="missing" Style="{StaticResource ConfigSetupWindow_WarnTXT}"/>
                </StackPanel>

                <!--Folder NOT NEEDED FOR NOW-->
                <StackPanel Margin="20 20 0 0" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
                    <TextBox Name="PowerShellPath_0" LostFocus="Tbx_LostFocus" GotFocus="Tbx_GotFocus" TextChanged="Tbx_TextChanged" Style="{StaticResource Tbx_Edi4}" Text="{Binding PowerShellPath, Mode=TwoWay}" ToolTip="{Binding PowerShellPath}"/>
                    <Button Name="PowerShellPath_1" Click="Button_Click" Style="{StaticResource JobsBTN_OpenFolder}" Margin="5 0 0 0" />
                    <Button Name="PowerShellPath_2" Click="Button_Click" Style="{StaticResource JobsBTN_QuestionMark}" Margin="5 0 0 0" />
                    <Button Name="PowerShellPath_3" Click="Button_Click" Style="{StaticResource JobsBTN_ClearProcessVideoPath}" Margin="5 0 0 0" />
                    <TextBlock Name="PowerShellPath_4" Text="missing" Style="{StaticResource ConfigSetupWindow_WarnTXT}"/>
                </StackPanel>

            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Button x:Name="Save_BTN" Style="{StaticResource SaveCancelBTN}" Content="Save" Background="#91f2a8" Margin="0 0 0 0" Click="Button_Click"/>
            <Button x:Name="Cancel_BTN" Style="{StaticResource SaveCancelBTN}" Content="Cancel" Background="#ed8a8a" Margin="20 0 0 0" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
