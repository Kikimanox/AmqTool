<Window x:Class="AmqTool.editffmpegstuff"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AmqTool"
        mc:Ignorable="d"
        Title="editffmpegstuff" Height="500" Width="600">
    <Grid Background="#1e1e1e">
        <Grid.RowDefinitions>
            <RowDefinition Height="60*"/>
            <RowDefinition Height="425*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Button x:Name="Save_BTN" Style="{StaticResource SaveCancelBTN}" Width="60" Content="Done" Background="#91f2a8" Margin="0 0 0 0" Click="Button_Click"/>
            <Button x:Name="Cancel_BTN" Style="{StaticResource SaveCancelBTN}" Width="60" Content="Cancel" Background="#ed8a8a" Margin="10 0 0 0" Click="Button_Click"/>
            <ComboBox IsReadOnly="True" Name="_AdvCbx" Style="{StaticResource ComboBoxFlatStyle}" Margin="15 0 0 0" Width="200" Height="30" SelectionChanged="_AdvCbx_SelectionChanged"/>
            <TextBlock Text="Use 2 pass" Style="{StaticResource AboutSub}" FontWeight="SemiBold" Margin="15 10 0 0"/>
            <CheckBox x:Name="_chkbx" Style="{StaticResource CheckboxJobs}" IsEnabled="True" IsHitTestVisible="True" Margin="5 9 0 0"/>
            <Button ToolTip="Sets the ALL ffmpeg code/flags to their default values" x:Name="Default_BTN" Style="{StaticResource SaveCancelBTN}" Width="65" Height="30" Content="Default" Background="#8ad9ed" Margin="30 0 0 0" Click="Button_Click"/>
        </StackPanel>
        <RichTextBox Grid.Row="1"
                     x:Name="_RTB"
                     Padding="5"
                     Background="#1e1e1e"
                     Foreground="#d4d4d4"
                     FontSize="14"
                     ScrollViewer.CanContentScroll="False"
                     VerticalScrollBarVisibility="Auto" 
                     HorizontalScrollBarVisibility="Auto" 
                     ContextMenuOpening="_RTB_ContextMenuOpening"
                     TextChanged="_RTB_TextChanged"
                     >
            <FlowDocument/>
            <RichTextBox.Resources>
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>
    </Grid>
</Window>
